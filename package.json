{
  "name": "application-screening-agent",
  "version": "1.0.0",
  "private": true,
  "description": "An AI agent that screens job applications with tool calls, guardrails and human approval for rejections.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "screen": "node --env-file-if-exists=.env --import tsx src/cli/screen.ts",
    "review": "node --env-file-if-exists=.env --import tsx src/cli/review.ts",
    "audit:verify": "node --import tsx src/cli/verify-audit.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
